      "id": "beauti-analysis-map-cache",
      "usage": "independent_implementation",
      "sources": [],
      "license_evidence": "New project C++ and test code under GPL-3.0-or-later. Uses existing OBS graphics APIs; no third-party implementation, new model, or library imported.",
      "modifications": "Reuse uploaded immutable analysis maps and graphics-prepared mask for slider redraws. Key by generation/sequence, with dimension and raw-format guards; invalidate before failed uploads or mask preparation. Inference placement, model bytes, runtime versions, precision, and frame scheduling remain unchanged.",
      "local_paths": [
        "src/plugin/gpu.h",
        "src/plugin/gpu.cpp",
        "src/plugin/filter.cpp",
        "tests/native/gpu_pipeline.cpp"
      ]
    },
    {
      "id": "beauti-dodge-burn",
      "usage": "independent_implementation_with_visual_reference",
      "sources": [
        "https://retouch4.me/dodgeburn"
      ],
      "license_evidence": "New C++ GPL-3.0-or-later. No proprietary model, source, or SDK imported. D65/sRGB math and box-averaging implementation reuse independently authored project Skin Tone/Texture code and existing provenance.",
      "modifications": "Masked local L* correction estimated between fine/coarse fields. Small radius 0.0025*face side; large radius 0.018*side; variance/36 guard; 4*tanh(0.85*residual/4) bound; near-black/white protection; fixed Lab a*/b* and gamut backoff. Four independent controls with matched no-Dodge smoothing endpoints. Independently authored full-resolution face-ROI GPU port, original-pixel composition, explicit masked neighborhoods, matching Lab/gamut rules and four 150 ms strength ramps.",
      "local_paths": [
        "src/effects/dodge_burn.cpp",
        "src/effects/effects.h",
        "src/plugin/gpu.cpp",
        "data/beauti.effect",
        "docs/DODGE-BURN.md"
      ]
    },
    {
      "id": "beauti-texture",
      "usage": "independent_implementation_with_concept_and_visual_references",
      "sources": [
        "https://blog.adobe.com/en/publish/2019/05/14/from-the-acr-team-introducing-the-texture-control",
        "https://docs.darktable.org/usermanual/development/en/module-reference/processing-modules/contrast-equalizer/",
        "https://people.csail.mit.edu/sparis/publi/2011/siggraph/",
        "https://imagine.enpc.fr/~aubrym/projects/llf/index.html"
      ],
      "license_evidence": "Independently authored C++ GPL-3.0-or-later. No reference source, binary, or weights imported. Existing D65/sRGB math and its provenance reused from Beauti Skin Tone. Product/paper links are references, not a redistribution grant.",
      "modifications": "Four full-resolution range-weighted five-tap L* detail bands; gains 0.45/0.85/0.70/0.20, thresholds 6/7/9/12 L*, face-size tap spacing, original lightness guide, normalized mask support, bounded 6*tanh correction, fixed Lab a*/b* with gamut backoff. Not an Adobe, darktable, or Local Laplacian reproduction. Independently authored full-resolution face-ROI GPU port, original-pixel composition, explicit masked neighborhoods, matching Lab/gamut rules and four 150 ms strength ramps.",
      "local_paths": [
        "src/effects/texture.cpp",
        "src/effects/effects.h",
        "src/plugin/gpu.cpp",
        "data/beauti.effect",
        "docs/TEXTURE.md"
