      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-ci",
      "configurePreset": "macos-ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-asan",
      "configurePreset": "macos-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-tsan",
      "configurePreset": "macos-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ci",
      "configurePreset": "windows-ci",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-cpu-ci",
      "configurePreset": "windows-cpu-ci",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "macos",
      "steps": [
        {
          "type": "configure",
          "name": "macos"
        },
        {
          "type": "build",
          "name": "macos"
        },
        {
          "type": "test",
          "name": "macos"
        }
      ]
    },
    {
      "name": "windows",
      "steps": [
        {
          "type": "configure",
          "name": "windows"
        },
        {
          "type": "build",
          "name": "windows"
        },
        {
          "type": "test",
          "name": "windows"
        }
      ]
    },
    {
