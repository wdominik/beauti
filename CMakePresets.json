{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos",
      "displayName": "Beauti \u00b7 macOS arm64",
      "description": "Fetches pinned OBS headers, SIMDe, and ONNX Runtime from buildspec.json; links against /Applications/OBS.app or the pinned OBS release image.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "27.0",
        "BUILD_TESTING": "ON",
        "BEAUTI_ENABLE_TENSORRT": "OFF"
      }
    },
    {
      "name": "windows",
      "displayName": "Beauti \u00b7 Windows x64 NVIDIA",
      "description": "Requires uv run beauti-prepare-windows --device tensorrt first.",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-tensorrt",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "BEAUTI_ENABLE_TENSORRT": "ON"
      }
    },
    {
      "name": "windows-cpu",
      "inherits": "windows",
      "displayName": "Beauti \u00b7 Windows x64 CPU validation",
      "description": "Requires uv run beauti-prepare-windows --device cpu first.",
      "binaryDir": "${sourceDir}/build/windows-cpu",
      "cacheVariables": {
        "BEAUTI_ENABLE_TENSORRT": "OFF"
      }
    },
    {
      "name": "macos-ci",
      "inherits": "macos",
      "displayName": "Beauti \u00b7 macos (CI)",
      "description": "CI variant: warnings are errors (CMAKE_COMPILE_WARNING_AS_ERROR).",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    },
    {
      "name": "macos-asan",
      "inherits": "macos",
      "displayName": "Beauti \u00b7 macOS arm64 (AddressSanitizer and UndefinedBehaviorSanitizer)",
      "description": "AddressSanitizer and UndefinedBehaviorSanitizer on every target, optimized with debug info; for CTest, beauti-gpu-check, and the libobs fixture runner. Never package this build.",
      "binaryDir": "${sourceDir}/build/macos-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BEAUTI_SANITIZER": "address"
      }
    },
    {
      "name": "macos-tsan",
      "inherits": "macos",
      "displayName": "Beauti \u00b7 macOS arm64 (ThreadSanitizer)",
      "description": "ThreadSanitizer on every target, optimized with debug info; for CTest, beauti-gpu-check, and the libobs fixture runner. Never package this build.",
      "binaryDir": "${sourceDir}/build/macos-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BEAUTI_SANITIZER": "thread"
      }
    },
    {
      "name": "windows-ci",
      "inherits": "windows",
      "displayName": "Beauti \u00b7 windows (CI)",
      "description": "CI variant: warnings are errors (CMAKE_COMPILE_WARNING_AS_ERROR).",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    },
    {
      "name": "windows-cpu-ci",
      "inherits": "windows-cpu",
      "displayName": "Beauti \u00b7 windows-cpu (CI)",
      "description": "CI variant: warnings are errors (CMAKE_COMPILE_WARNING_AS_ERROR).",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos",
      "configurePreset": "macos"
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release"
    },
    {
      "name": "windows-cpu",
      "configurePreset": "windows-cpu",
      "configuration": "Release"
    },
    {
      "name": "macos-ci",
      "configurePreset": "macos-ci"
    },
    {
      "name": "macos-asan",
      "configurePreset": "macos-asan"
    },
    {
      "name": "macos-tsan",
      "configurePreset": "macos-tsan"
    },
    {
      "name": "windows-ci",
      "configurePreset": "windows-ci",
      "configuration": "Release"
    },
    {
      "name": "windows-cpu-ci",
      "configurePreset": "windows-cpu-ci",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "macos",
      "configurePreset": "macos",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-cpu",
