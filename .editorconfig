root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h,hpp,mm,effect}]
indent_style = tab
indent_size = 8
max_line_length = 120

[*.{py,pyi}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,yml,yaml,toml,cmake,txt,ini}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 90
